{
  "name": "nkg-ai-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "nkg-ai-flow/packages/*",
    "nkg-ai-flow/packages/transports/*",
    "nkg-ai-flow/apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:nkg": "npm test --prefix nkg-ai-flow -- --run",
    "test:nkg:browser": "npm run test:browser-bundle --prefix nkg-ai-flow",
    "test:example-flows": "npm run test:example-flows --prefix nkg-ai-flow",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/tauri-runtime-adapter/tsconfig.json",
    "release:local": "node scripts/local-release.mjs",
    "release:local:plan": "node scripts/local-release.mjs --dry-run",
    "release:local:quick": "node scripts/local-release.mjs --skip-install --skip-tests",
    "build:sidecar": "npm run build -w @nkg-ai-bot/runtime-sidecar",
    "build:client": "npm run build -w @nkg-ai-bot/client",
    "test:bundle-budget": "node scripts/check-client-bundle.mjs",
    "build:desktop-power": "npm run build:desktop-power -w @nkg-ai-bot/client",
    "tauri:desktop-power": "npm run tauri:desktop-power -w @nkg-ai-bot/client --",
    "android:init": "npm run tauri -w @nkg-ai-bot/client -- android init",
    "android:build": "node scripts/android-build.mjs",
    "android:build:debug": "node scripts/android-build.mjs --debug",
    "ios:init": "npm run tauri -w @nkg-ai-bot/client -- ios init",
    "ios:build": "npm run tauri -w @nkg-ai-bot/client -- ios build",
    "ios:build:debug": "npm run tauri -w @nkg-ai-bot/client -- ios build --debug",
    "mock:provider": "node scripts/mock-openai-server.mjs",
    "android:e2e:chat": "node scripts/android-chat-e2e.mjs",
    "android:e2e:lifecycle": "node scripts/android-chat-e2e.mjs --lifecycle",
    "tauri": "npm run tauri -w @nkg-ai-bot/client --",
    "rust:check": "node scripts/cargo.mjs check --manifest-path apps/client/src-tauri/Cargo.toml",
    "rust:test": "node scripts/cargo.mjs test --manifest-path apps/client/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "extract-zip": "^2.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
