    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-stronghold": "^2",
    "@nkg-ai-bot/runtime-router": "0.0.1",
    "@nkg-ai-bot/tauri-runtime-adapter": "0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
