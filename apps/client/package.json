{
  "name": "@nkg-ai-bot/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite",
    "build": "npm run build:frontend",
    "build:desktop-power": "npm run sidecar:build && npm run build:frontend",
    "build:frontend": "tsc -b && vite build && node ../../scripts/check-client-bundle.mjs",
    "sidecar:build": "npm run build -w @nkg-ai-bot/runtime-sidecar",
    "preview": "vite preview",
    "tauri": "node ../../scripts/tauri.mjs",
    "tauri:desktop-power": "node ../../scripts/tauri.mjs build --features desktop-power --config src-tauri/tauri.desktop-power.conf.json"
  },
  "dependencies": {
    "@ai-native-flow/flow-validator": "0.0.1",
    "@nkg-ai-bot/runtime-router": "0.0.1",
    "@nkg-ai-bot/tauri-runtime-adapter": "0.0.1",
    "@noble/hashes": "^1.8.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-stronghold": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@ai-native-flow/flow-builder": "0.0.1",
    "@ai-native-flow/runtime": "0.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
