POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://nkg:replace-with-a-long-random-password@postgres:5432/nkg_commerce
NKG_PUBLIC_BASE_URL=https://api.lfzxb.top
NKG_SESSION_DAYS=30
NKG_RUN_TTL_SECONDS=300
# Keep this at 0 until App Attest or equivalent anti-abuse controls are enabled.
NKG_WELCOME_GRANT_POINTS=0
NKG_RUN_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Internal New API address is preferred so the proxy does not loop through the public domain.
NEW_API_BASE_URL=http://host.docker.internal:3000
NEW_API_ALLOW_INSECURE_HTTP=true
NEW_API_KEY=replace-with-a-dedicated-new-api-service-token

APPLE_BUNDLE_ID=com.nkg.ai.bot
APPLE_APP_ID=1234567890
APPLE_ROOT_CA_PATHS=/certs/AppleRootCA-G3.cer,/certs/AppleRootCA-G2.cer

# reservePoints is the maximum charge reserved for one run. Missing upstream usage fails closed at this amount.
NKG_MODELS_JSON=[{"id":"nkg-fast","name":"NKG Fast","contextWindow":128000,"inputPointsPerMillionTokens":100,"outputPointsPerMillionTokens":500,"reservePoints":100,"capabilities":["text","vision","tools"]}]
NKG_POINT_PACKS_JSON=[{"id":"points-600","points":600,"appleProductId":"com.nkg.ai.bot.points.600","featured":false},{"id":"points-2000","points":2000,"appleProductId":"com.nkg.ai.bot.points.2000","featured":true}]
